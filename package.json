{
  "name": "slop-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for a Vue-first, headless-first UI component library.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "boundaries": "node scripts/check-package-boundaries.mjs",
    "build": "pnpm --filter @slop-ui/* --filter !@slop-ui/docs --if-present build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "dev": "pnpm --filter @slop-ui/playground dev",
    "docs:build": "pnpm --filter @slop-ui/docs build",
    "docs:dev": "pnpm --filter @slop-ui/docs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm format:check",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm --filter @slop-ui/playground build && playwright test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm docs:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.0",
    "@types/node": "22.20.1",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  }
}
